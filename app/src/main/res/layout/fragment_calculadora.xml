        android:textColor="#DB36F4"
        android:textSize="30sp"
        app:backgroundTint="#00B2D6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/btn_9"
