        android:textColor="#E47841"
        android:textSize="30sp"
        app:backgroundTint="#00B2D6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/BotaoRedondo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_igual"
        android:layout_width="70dp"
        android:layout_height="60dp"
        android:layout_marginTop="644dp"
        android:text="="
        android:textColor="@color/white"
        android:textSize="30sp"
        app:backgroundTint="#DB36F4"
        app:iconTint="#FF5722"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/btn_virgula"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/BotaoRedondo" />

    <TextView
        android:id="@+id/tv_resultado"
        android:layout_width="0sp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32sp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="32sp"
        android:gravity="end"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_expressao" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_divisao"
        android:layout_width="70dp"
        android:layout_height="60dp"
        android:layout_marginTop="372dp"
        android:text="÷"
        android:textColor="#DB36F4"
        android:textSize="30sp"
        app:backgroundTint="#00B2D6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
