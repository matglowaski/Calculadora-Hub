<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00B2D6"
    android:backgroundTint="#00B2D6">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_8"
        android:layout_width="70dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="440dp"
        android:text="8"
        android:textColor="#E47841"
        android:textSize="30sp"
        app:backgroundTint="#00B2D6"
        app:layout_constraintStart_toEndOf="@+id/btn_7"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/BotaoRedondo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_mais"
        android:layout_width="70dp"
        android:layout_height="60dp"
        android:layout_marginTop="576dp"
        android:text="+"
        android:textColor="#DB36F4"
        android:textSize="30sp"
        app:backgroundTint="#00B2D6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/btn_3"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/BotaoRedondo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_virgula"
        android:layout_width="70dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="644dp"
        android:text=","
        android:textColor="#E47841"
        android:textSize="32sp"
        app:backgroundTint="#00B2D6"
        app:layout_constraintStart_toEndOf="@+id/btn_0"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/BotaoRedondo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_0"
        android:layout_width="70dp"
        android:layout_height="60dp"
        android:layout_marginStart="168dp"
        android:layout_marginTop="644dp"
        android:text="0"
        android:textColor="#E47841"
        android:textSize="30sp"
        app:backgroundTint="#00B2D6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/BotaoRedondo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_9"
        android:layout_width="70dp"
        android:layout_height="60dp"
